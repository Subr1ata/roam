<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F2">

    <FrameLayout
        android:id="@+id/onboardingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/onboardingPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/wordmarkTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:letterSpacing="-0.04"
                android:text="roam."
                android:textColor="#23352C"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/skipButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_onboarding_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Sign in"
                android:textColor="#315B45"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.roam.app.ui.onboarding.SwipeableOnboardingSheet
            android:id="@+id/onboardingSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_onboarding_sheet"
            android:elevation="16dp"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="24dp"
            android:paddingEnd="26dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/authStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:text="A LITTLE ROOM TO WANDER"
                android:textColor="#657568"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/pageDots"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/slideTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.02"
                android:textColor="#20271F"
                android:textSize="34sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/slideDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:fontFamily="sans"
                android:lineSpacingExtra="3dp"
                android:textColor="#74776F"
                android:textSize="14sp" />

            <Button
                android:id="@+id/getStartedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#315B45"
                android:fontFamily="sans"
                android:letterSpacing="0.01"
                android:text="Get started"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/continueSignInButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_onboarding_secondary_button"
                android:fontFamily="sans"
                android:text="I already have an account"
                android:textAllCaps="false"
                android:textColor="#315B45"
                android:textSize="14sp"
                android:textStyle="bold" />
        </com.roam.app.ui.onboarding.SwipeableOnboardingSheet>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/authContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/signedInContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
    </FrameLayout>
</FrameLayout>
